    {
      "id": 1788300657639,
      "likes": 0,
      "createdAt": "2026-09-01T22:10:57.639Z",
      "title": "პატიება",
      "author": "სად",
      "mood": "other",
      "excerpt": "",
      "description": "",
      "lines": [
        "მაპატიე რომ შენზე ფიქრებით მევსება გონება ბნელი",
        "რომ მჩვევია ღმერთის წინაშე გოდება ბევრი",
        "რომ მატყვევებს ამბორება შენი",
        "შენს პატიებას არც ველი",
        "არ ვარ ღირსი დაე მომისაჯეთ საუკუნო კარცერი",
        "არ მაჩვენოთ მზე და მთავრე",
        "მხოლოდ უკინითი ღამე",
        "კამათი საკუთარ თავთან",
        "ერთი სანთელი და თამაში ცეცხლის ალთან",
        "არა ასე ფუჭად არ ჩაივლის ჩემი ცხოვრება",
        "მუდმივად ხვეწნა და ვედრება",
        "არა ეს არ მსურს მინდა გისოსი ვძლიო ძირს",
        "მინდა დაბნლება ამ მზის",
        "მინდა განადგურება იმ დღის",
        "როცა, როცა მოგაყენე ტკივილი",
        "ღირსი ვარ ყურს მიხვრეტდეს შენი ყოველი კივილი",
        "ღირსი ვარ კანს მიდნობდეს შენი ტირილი",
        "მინდა, მინდა ტბის პირას სევდით სავსე ვიჯდე როგორც ტირიფი",
        "მაპატიე",
        "მაპატიე რომ ვერ დავძარი ცხრა მთა",
        "მაპატიე რომ ვერ დავაშრე ცხრა ზღვა",
        "რომ ვერ ვუყავი ესკალიბურს ძვრა",
        "ვიკარგები ამ ქარში",
        "ვით ფერფლი ცეცხლის ალში",
        "რომელიც ანთია ჩემს გულში",
        "და ანათებს ყველა წერტილს ჩემს სულში",
        "აბა სცადე და მომიშორე",
        "როგორ გაგიშვებ როცა ძვლივს მოგიპოვე",
        "შემოგეხვევი როგორც მუხას ხავსი",
        "და ვერ დამძლევს ვერავის ნავსი",
        "თითქოს გავშიფრე სამყაროს არსი"
      ]
    }
  ]
}